<Window x:Class="WpfAppMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMVVM"
        mc:Ignorable="d"
        Name="mainwindow"
        MinHeight="450"
        MinWidth="800"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Wheat">
        <Grid Background="LightGray" Grid.Row="1" Margin="25,40,25,15">
            <TextBox Name="FilterTextBox" TextChanged="FilterTextBox_TextChanged" Height="30" Width="200" Margin="0,0,500,300"/>
            <TextBlock Text="Filter" Height="30" Width="100" TextAlignment="Center" FontSize="20" Margin="0,0,200,300"/>
            <Button Height="30" Command="{Binding ShowAddUserWindowCommand}" CommandParameter="{x:Reference Name=mainwindow}" Content="Add User" Width="100" VerticalContentAlignment="Center" Padding="5" Margin="550,0,0,300"/>
            <Button Height="30" Command="{Binding RefreshUserWindowList}" Content="Refresh" Width="100" VerticalContentAlignment="Center" Padding="5" Margin="250,0,0,300"/>
            <ListView Name="UserList" ItemsSource="{Binding Users}" BorderBrush="#cdcdcd" Margin="25,70,25,25" Padding="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="Name"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Email}" Header="Email"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Role}" Header="Role"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
