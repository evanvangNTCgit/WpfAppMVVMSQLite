<Window x:Class="WpfAppMVVM.Views.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMVVM.Views"
        mc:Ignorable="d"
        MinHeight="450"
        MinWidth="300"
        Name="AddUserWindow"
        Title="AddUser" Height="450" Width="300">
    <Grid>
        <StackPanel>
            <Label Content="Name" Margin="25" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Name}" Height="30" Width="200" Margin="5,0" VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="2"/>

            <Label Content="Email" Margin="25" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Email}" Height="30" Width="200" Margin="5,0" VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="2"/>
            
            <Label Content="Role" Margin="25" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Role}" Height="30" Width="200" Margin="5,0" VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="2"/>

            <Button CommandParameter="{x:Reference AddUserWindow}" Command="{Binding AddUserCommand}" Content="Add" Height="30" Width="70" Padding="5" Margin="50"/>
        </StackPanel>
    </Grid>
</Window>
